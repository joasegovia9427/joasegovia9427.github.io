---
import Layout from '../layouts/Layout.astro';
import { House, FolderOpen } from '@lucide/astro';
---

<Layout
  title='404 - Page Not Found | Joaquin Segovia Portfolio'
  description="The page you're looking for doesn't exist."
>
  <div class='flex min-h-screen items-center justify-center px-4 py-20'>
    <div class='mx-auto max-w-2xl text-center'>
      <!-- Large 404 Number -->
      <h1 class='text-primary mb-4 animate-pulse text-9xl font-bold'>404</h1>

      <!-- Error Title -->
      <h2 class='mb-4 text-4xl font-bold'>Page Not Found</h2>

      <!-- Error Description -->
      <p class='text-base-content/70 mb-8 text-xl'>
        Oops! The page you're looking for doesn't exist or has been moved. Let's
        get you back on track.
      </p>

      <!-- Divider -->
      <div class='divider'></div>

      <!-- Action Buttons -->
      <div class='mt-8 flex flex-wrap justify-center gap-4'>
        <a href='/' class='btn btn-primary gap-2'>
          <House class='size-5' />
          Go Home
        </a>
        <a href='/experience' class='btn btn-outline gap-2'>
          <FolderOpen class='size-5' />
          View Experience
        </a>
      </div>

      <!-- Helpful Links -->
      <div class='mt-12 flex justify-center gap-2'>
        <p class='text-base-content/60 mb-4 text-sm'>
          You might be looking for:
        </p>
        <div class='flex flex-wrap justify-center gap-3 text-sm'>
          <a href='/#about' class='link link-hover'>About</a>
          <span class='text-base-content/30'>•</span>
          <a href='/experience' class='link link-hover'>Experience</a>
          <span class='text-base-content/30'>•</span>
          <a href='/projects' class='link link-hover'>Projects</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
