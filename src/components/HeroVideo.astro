---
import { Volume2, VolumeX, Play, Pause } from '@lucide/astro';

interface Props {
  /** Video URL (string or Astro imported asset with .src) */
  src: string | { src: string };
}

const { src } = Astro.props;
const videoSrc = typeof src === 'string' ? src : src.src;
---

<div
  class='pointer-events-none absolute inset-0 z-0 h-full w-full overflow-hidden dark:opacity-20'
  style='opacity: 1;'
>
  <video
    id='hero-video'
    autoplay
    loop
    playsinline
    muted
    class='h-full w-full object-cover dark:mask-[radial-gradient(circle_at_center,white,transparent)]'
    aria-label='Decorative background video'
  >
    <source src={videoSrc} type='video/mp4' />
    <track kind='captions' src='' srclang='en' label='English' />
  </video>
</div>
<button
  type='button'
  id='hero-video-sound'
  class='btn btn-circle btn-ghost btn-hero-hover pointer-events-auto absolute top-15 right-3 z-10 animate-[fadeInToLeft_1.6s_ease-out_0s_both] text-white hover:bg-gray-100/80 hover:text-black'
  aria-label='Unmute video'
  title='Toggle sound'
>
  <span id='icon-muted'>
    <Volume2 class='size-5' aria-hidden='true' />
  </span>
  <span id='icon-unmuted' class='hidden'>
    <VolumeX class='size-5' aria-hidden='true' />
  </span>
</button>
<button
  type='button'
  id='hero-video-play-pause'
  class='btn btn-circle btn-ghost btn-hero-hover pointer-events-auto absolute top-25 right-3 z-10 animate-[fadeInToLeft_1.6s_ease-out_0s_both] text-white hover:bg-gray-100/80 hover:text-black'
  aria-label='Play/Pause video'
  title='Play/Pause video'
>
  <span id='icon-play'>
    <Play class='size-5' aria-hidden='true' />
  </span>
  <span id='icon-pause' class='hidden'>
    <Pause class='size-5' aria-hidden='true' />
  </span>
</button>
<script>
  const video = document.getElementById(
    'hero-video',
  ) as HTMLVideoElement | null;
  const btnSound = document.getElementById('hero-video-sound');
  const btnPlayPause = document.getElementById('hero-video-play-pause');
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');

  if (video && btnSound && iconMuted && iconUnmuted) {
    function updateIcons() {
      const isMuted = video!.muted;
      iconMuted!.classList.toggle('hidden', !isMuted);
      iconUnmuted!.classList.toggle('hidden', isMuted);
    }
    btnSound.addEventListener('click', () => {
      const v = video;
      v.muted = !v.muted;
      btnSound.setAttribute(
        'aria-label',
        v.muted ? 'Unmute video' : 'Mute video',
      );
      updateIcons();
    });
    updateIcons();
  }

  if (video && btnPlayPause && iconPlay && iconPause) {
    function updateIconsPlayPause() {
      const isPlaying = !video!.paused;
      iconPlay!.classList.toggle('hidden', isPlaying);
      iconPause!.classList.toggle('hidden', !isPlaying);
    }
    btnPlayPause.addEventListener('click', () => {
      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
      updateIconsPlayPause();
    });
    video.addEventListener('play', updateIconsPlayPause);
    video.addEventListener('pause', updateIconsPlayPause);
    updateIconsPlayPause();
  }
</script>
