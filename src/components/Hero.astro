---
import { Image } from 'astro:assets';
import { getIcon } from '../utils/iconMapper';
import { getEntry } from 'astro:content';
import { BlurFadeText } from './ui/blur-fade-text';
import HeroVideo from './HeroVideo.astro';
import heroBackgroundVideo from '@assets/hero/hero_background_video.mp4';

const heroEntry = await getEntry('hero', 'index');

if (!heroEntry) {
  throw new Error('Hero entry not found');
}

const { name, title, location, description, socialLinks, avatar } =
  heroEntry.data;
---

<section class='hero min-h-screen'>
  <HeroVideo src={heroBackgroundVideo} />

  <div
    class='hero-content light:bg-gray-100/80 max-w-7xl flex-col rounded-lg bg-gray-900/80 p-5 backdrop-blur-sm lg:flex-row-reverse'
  >
    <div
      class='hover-3d animate-[fadeInToDown_1.4s_ease-out_0s_both] lg:animate-[fadeInToLeft_1.4s_ease-out_0s_both]'
    >
      <figure class='mask mask-squircle w-48 max-w-100 lg:w-64'>
        {
          typeof avatar === 'string' ? (
            <img src={avatar} alt={name} />
          ) : (
            <Image src={avatar} alt={name} />
          )
        }
      </figure>

      {Array.from({ length: 8 }).map(() => <div />)}
    </div>

    <div class='max-w-2xl text-center lg:text-left'>
      <BlurFadeText
        client:load
        as='h1'
        text={`Hi, I'm ${name}`}
        className='mb-4 text-4xl font-bold lg:text-5xl'
        delay={0.3}
        duration={1.4}
      />
      <BlurFadeText
        client:load
        as='p'
        text={title}
        className='skeleton skeleton-text text-base-content/80 mb-2 text-xl'
        delay={0.4}
        duration={1.5}
      />
      {
        location && (
          <BlurFadeText
            client:load
            as='p'
            text={location}
            className='text-base-content/60 mb-4'
            delay={0.5}
            duration={1.5}
          />
        )
      }
      <BlurFadeText
        client:load
        as='p'
        text={description}
        className='mb-6 text-lg leading-relaxed'
        delay={location ? 0.45 : 0.3}
        duration={1.6}
      />
      <div
        class='grid animate-[fadeInToUp_1.6s_ease-out_1s_both] grid-cols-5 justify-items-center gap-2 lg:flex lg:justify-start lg:gap-4'
      >
        {
          socialLinks.map(link => {
            const IconComponent = getIcon(link.icon as any);
            return (
              <div class='tooltip tooltip-top' data-tip={link.label}>
                <a
                  href={link.url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='btn btn-circle btn-primary lg:btn-ghost hover:bg-gray-100/80 hover:text-gray-900'
                  aria-label={link.label}
                >
                  <IconComponent class='size-6' />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
