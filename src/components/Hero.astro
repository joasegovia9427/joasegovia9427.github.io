---
import { Image } from 'astro:assets';
import { Volume2, VolumeX } from '@lucide/astro';
import { getIcon } from '../utils/iconMapper';
import { getEntry } from 'astro:content';
import { BlurFadeText } from './ui/blur-fade-text';
import heroBackgroundVideo from '@assets/hero/hero_background_video.mp4';

const heroEntry = await getEntry('hero', 'index');

if (!heroEntry) {
  throw new Error('Hero entry not found');
}

const { name, title, location, description, socialLinks, avatar } =
  heroEntry.data;
---

<section class='hero min-h-screen'>
  <div
    class='pointer-events-none absolute inset-0 z-0 h-full w-full overflow-hidden dark:opacity-20'
    style='opacity: 1;'
  >
    <video
      id='hero-video'
      autoplay
      loop
      playsinline
      muted
      class='h-full w-full object-cover dark:[mask-image:radial-gradient(circle_at_center,white,transparent)]'
      aria-label='Decorative background video'
    >
      <source src={heroBackgroundVideo} type='video/mp4' />
      <track kind='captions' src='' srclang='en' label='English' />
    </video>
  </div>
  <button
    type='button'
    id='hero-video-sound'
    class='btn btn-circle btn-ghost pointer-events-auto absolute top-15 right-3 z-10 animate-[fadeInToLeft_1.6s_ease-out_0s_both] text-white hover:bg-gray-100/80 hover:text-black'
    aria-label='Unmute video'
    title='Toggle sound'
  >
    <span id='icon-muted'>
      <Volume2 class='size-5' aria-hidden='true' />
    </span>
    <span id='icon-unmuted' class='hidden'>
      <VolumeX class='size-5' aria-hidden='true' />
    </span>
  </button>
  <script>
    const video = document.getElementById(
      'hero-video',
    ) as HTMLVideoElement | null;
    const btn = document.getElementById('hero-video-sound');
    const iconMuted = document.getElementById('icon-muted');
    const iconUnmuted = document.getElementById('icon-unmuted');
    if (video && btn && iconMuted && iconUnmuted) {
      function updateIcons() {
        const isMuted = video!.muted;
        iconMuted!.classList.toggle('hidden', !isMuted);
        iconUnmuted!.classList.toggle('hidden', isMuted);
      }
      btn.addEventListener('click', () => {
        const v = video;
        v.muted = !v.muted;
        btn.setAttribute('aria-label', v.muted ? 'Unmute video' : 'Mute video');
        updateIcons();
      });
      updateIcons();
    }
  </script>

  <div
    class='hero-content light:bg-gray-100/80 max-w-7xl flex-col rounded-lg bg-gray-900/80 p-5 backdrop-blur-sm lg:flex-row-reverse'
  >
    <div
      class='hover-3d animate-[fadeInToDown_1.4s_ease-out_0s_both] lg:animate-[fadeInToLeft_1.4s_ease-out_0s_both]'
    >
      <figure class='mask mask-squircle w-48 max-w-100 lg:w-64'>
        {
          typeof avatar === 'string' ? (
            <img src={avatar} alt={name} />
          ) : (
            <Image src={avatar} alt={name} />
          )
        }
      </figure>

      {Array.from({ length: 8 }).map(() => <div />)}
    </div>

    <div class='max-w-2xl text-center lg:text-left'>
      <BlurFadeText
        client:load
        as='h1'
        text={`Hi, I'm ${name}`}
        className='mb-4 text-4xl font-bold lg:text-5xl'
        delay={0.3}
        duration={1.4}
      />
      <BlurFadeText
        client:load
        as='p'
        text={title}
        className='skeleton skeleton-text text-base-content/80 mb-2 text-xl'
        delay={0.4}
        duration={1.5}
      />
      {
        location && (
          <BlurFadeText
            client:load
            as='p'
            text={location}
            className='text-base-content/60 mb-4'
            delay={0.5}
            duration={1.5}
          />
        )
      }
      <BlurFadeText
        client:load
        as='p'
        text={description}
        className='mb-6 text-lg leading-relaxed'
        delay={location ? 0.45 : 0.3}
        duration={1.6}
      />
      <div
        class='grid animate-[fadeInToUp_1.6s_ease-out_1s_both] grid-cols-5 justify-items-center gap-2 lg:flex lg:justify-start lg:gap-4'
      >
        {
          socialLinks.map(link => {
            const IconComponent = getIcon(link.icon as any);
            return (
              <div class='tooltip tooltip-top' data-tip={link.label}>
                <a
                  href={link.url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='btn btn-circle btn-primary lg:btn-ghost hover:bg-gray-100/80 hover:text-gray-900'
                  aria-label={link.label}
                >
                  <IconComponent class='size-6' />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
