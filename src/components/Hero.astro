---
import { Image } from 'astro:assets';
import { getIcon } from '../utils/iconMapper';
import { getEntry } from 'astro:content';
import BlurFadeTextCSS from './BlurFadeTextCSS.astro';
import HeroVideo from './HeroVideo.astro';
import heroBackgroundVideo from '@assets/hero/hero_background_video.mp4';

const heroEntry = await getEntry('hero', 'index');

if (!heroEntry) {
  throw new Error('Hero entry not found');
}

const { name, title, location, description, socialLinks, avatar } =
  heroEntry.data;
---

<section class='hero min-h-screen'>
  <HeroVideo src={heroBackgroundVideo} />

  <div
    class='hero-content light:bg-gray-100/80 h-full max-w-7xl flex-col bg-gray-900/80 p-5 backdrop-blur-sm sm:h-auto sm:rounded-lg lg:flex-row-reverse'
  >
    <div
      class='hover-3d animate-[fadeInToDown_1.4s_ease-out_0s_both] lg:animate-[fadeInToLeft_1.4s_ease-out_0s_both]'
    >
      <figure
        class='mask mask-squircle w-32 max-w-100 sm:w-48 lg:w-64'
        style='aspect-ratio: 1;'
      >
        <Image
          src={avatar}
          alt={name}
          width={256}
          height={256}
          decoding='async'
          fetchpriority='high'
        />
      </figure>

      {Array.from({ length: 8 }).map(() => <div />)}
    </div>

    <div class='max-w-2xl text-center lg:text-left'>
      <BlurFadeTextCSS
        as='h1'
        text={`Hi, I'm ${name}`}
        className='mb-4 text-2xl font-bold sm:text-4xl lg:text-5xl'
        delay={0.3}
        duration={1.4}
      />
      <BlurFadeTextCSS
        as='p'
        text={title}
        className='skeleton skeleton-text text-base-content/80 mb-2 text-xl'
        delay={0.4}
        duration={1.5}
      />
      {
        location && (
          <BlurFadeTextCSS
            as='p'
            text={location}
            className='text-base-content/60 mb-4 text-sm sm:text-base'
            delay={0.5}
            duration={1.5}
          />
        )
      }
      <BlurFadeTextCSS
        as='p'
        text={description}
        className='mb-6 text-base leading-relaxed sm:text-lg'
        delay={location ? 0.45 : 0.3}
        duration={1.6}
      />
      <div
        class='grid animate-[fadeInToUp_1.6s_ease-out_1s_both] grid-cols-5 justify-items-center gap-2 lg:flex lg:justify-start lg:gap-4'
      >
        {
          socialLinks.map(link => {
            const IconComponent = getIcon(link.icon as any);
            return (
              <div class='tooltip tooltip-top' data-tip={link.label}>
                <a
                  href={link.url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='btn btn-circle btn-primary lg:btn-ghost hover:bg-gray-100/80 hover:text-gray-900'
                  aria-label={link.label}
                >
                  <IconComponent class='size-6' />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
